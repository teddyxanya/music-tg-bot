# ==========================================
# Telegram Music Bot & Downloader Configuration
# ==========================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567"

# Default Telegram Chat ID for search preview & confirmation
TELEGRAM_CHAT_ID="123456789"

# Owner user ID (optional, restricted commands)
TELEGRAM_OWNER_ID="123456789"

# Target Telegram Channel ID where approved music will be posted
# (Bot must be added as an administrator with 'Post Messages' rights)
MUSIC_CHANNEL_ID="-1001234567890"

# Secret token for Apple Shortcuts / Shazam webhook authorization
SHAZAM_SECRET_TOKEN="your_random_secret_token_here"

# Webhook HTTP server settings
WEBHOOK_HOST="127.0.0.1"
WEBHOOK_PORT="8082"

# Concurrency & Performance
MAX_WORKERS="4"
TEMP_EXPIRATION_SECONDS="7200"
