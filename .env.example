# ==========================================
# Telegram Music Bot & Downloader Configuration
# ==========================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567"

# Default Telegram Chat ID (optional)
TELEGRAM_CHAT_ID=""

# Default Fallback Telegram Channel / Group ID for music publishing (optional)
# Users can set their own channels using /setchannel @channel_name or /setchannel -100xxxxxxxxxx
DEFAULT_MUSIC_CHANNEL_ID=""

# Secret token for Apple Shortcuts / Shazam webhook authorization
SHAZAM_SECRET_TOKEN="your_random_secret_token_here"

# Webhook HTTP server settings
WEBHOOK_HOST="127.0.0.1"
WEBHOOK_PORT="8082"

# Concurrency & Worker Threads
MAX_WORKERS="4"

# Cache & Storage Retention Settings
# Retention time for pending downloads / temporary files on server disk
TEMP_EXPIRATION_SECONDS="86400"
CACHE_EXPIRATION_HOURS="24"

# SQLite track metadata & file_id cache retention in days (0 = keep forever)
CACHE_EXPIRATION_DAYS="30"
